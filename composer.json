{
	"name": "dktapps/pmforms",
	"type": "library",
	"description": "Form API library for PocketMine-MP plugins",
	"license": "LGPL-3.0-or-later",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": "^8.1",
		"pocketmine/pocketmine-mp": "^5.0.0"
	},
	"require-dev": {
		"axolotl-pm/pocketmine-mp": "5.49.1",
		"phpstan/phpstan": "^2.2.0",
		"phpstan/phpstan-strict-rules": "^2.0.0",
		"phpstan/extension-installer": "^1.4.0"
	},
	"autoload": {
		"psr-4": {
			"dktapps\\pmforms\\": "src/dktapps/pmforms/"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"analyse": "@php vendor/bin/phpstan analyse --no-progress"
	},
	"extra":{
		"virion": {
			"spec": "3.0",
			"namespace-root": "dktapps\\pmforms"
		}
	}
}
